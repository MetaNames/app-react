SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
NEXT_PUBLIC_ENV=test
NEXT_PUBLIC_LANDING_URL=https://metanames.app
# Canonical app URL used in robots.txt and sitemap.xml (keep the trailing slash)
NEXT_PUBLIC_WEBSITE_URL=https://app.metanames.app/
NEXT_PUBLIC_CONTRACT_DISABLED=false

# Sentry (server + client). Client capture requires the NEXT_PUBLIC_ variant.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
